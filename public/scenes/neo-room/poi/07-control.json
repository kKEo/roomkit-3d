{
  "id": "control",
  "label": "Control",
  "kicker": "operations room",
  "screenLabel": "control // online",
  "objects": [
    {
      "type": "controlDesk",
      "position": [12, 0, 9],
      "rotation": [0, -90, 0],
      "props": {
        "columns": 4,
        "screens": [
          { "source": "graph", "graph": "wave", "title": "NETWORK" },
          { "source": "text", "title": "STATUS", "lines": [
            "> core ......... OK",
