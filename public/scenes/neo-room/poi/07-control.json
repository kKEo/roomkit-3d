            { "node": "neb-07", "region": "east", "status": "degraded", "load": 91 },
            { "node": "neb-08", "region": "east", "status": "online", "load": 18 },
            { "node": "mega-3", "region": "north", "status": "offline", "load": 0 },
            { "node": "mega-4", "region": "north", "status": "online", "load": 63 },
            { "node": "osiris", "region": "west", "status": "degraded", "load": 55 }
