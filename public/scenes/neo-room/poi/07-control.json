          { "source": "graph", "graph": "radar", "title": "PERIMETER" },
          { "source": "rain", "label": "uplink // secure", "color": "#b80f7c" },
          { "source": "image", "src": "media/floorplan.svg" },
          { "source": "stats", "title": "FLEET", "feed": { "url": "data/nodes.json", "refresh": 15, "transform": "nodeStats" } },
          { "source": "rain", "label": "uplink // secure", "color": "#b80fcc" },
          { "source": "terminal", "title": "CONSOLE", "lines": [
